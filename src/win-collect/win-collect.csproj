<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms intentionally omitted — would cause ContextMenu/Application ambiguity with WPF -->
    <AssemblyName>win-collect</AssemblyName>
    <RootNamespace>WinCollect</RootNamespace>
    <!-- ApplicationIcon sets the .exe file icon — requires a valid Win32 ICO format file.
         Generated by scripts/generate-icons.ps1 (run locally or in CI before building). -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>win-collect — Keyboard Activity Collection Tool</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite local storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
    <!-- Pin the SQLite native lib to fix GHSA-2m69-gcr7-jv3q (high severity vuln in 2.1.10) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" />
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- System.Text.Json is built into .NET 10 — no explicit reference needed (NU1510) -->
    <!-- Hardcodet NotifyIcon for WPF system tray -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon resources — generated by scripts/generate-icons.ps1 in CI or locally -->
    <Resource Include="Resources\app.ico" Condition="Exists('Resources\app.ico')" />
    <Resource Include="Resources\tray-active.ico" Condition="Exists('Resources\tray-active.ico')" />
    <Resource Include="Resources\tray-inactive.ico" Condition="Exists('Resources\tray-inactive.ico')" />
  </ItemGroup>

</Project>
