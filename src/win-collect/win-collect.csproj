<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms intentionally omitted — would cause ContextMenu/Application ambiguity with WPF -->
    <AssemblyName>win-collect</AssemblyName>
    <RootNamespace>WinCollect</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>win-collect — Keyboard Activity Collection Tool</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Suppress single-file warnings for SQLite -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firebase REST client via HttpClient (no native Firebase .NET SDK for .NET 10) -->
    <!-- Local SQLite storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <!-- Hardcodet for NotifyIcon (system tray) in WPF -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon for tray -->
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\tray-active.ico" />
    <Resource Include="Resources\tray-inactive.ico" />
  </ItemGroup>

</Project>
